# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env asla GitHub'a gönderilmez.
DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-anahtar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=buraya-gemini-key
GEMINI_MODEL=gemini-3.6-flash
